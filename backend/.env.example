# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL connection string (read securely by backend only)
# Format: postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-empty-wave-35284158.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for signing student and teacher session tokens
JWT_SECRET="unitask_super_secret_jwt_key_change_in_production"

# Server Port (default 3000)
PORT="3000"
